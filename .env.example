# Sao chép thành .env và điền giá trị. KHÔNG commit file .env.

# ---- Backend (Spring Boot) ----
# JDBC URL tới Postgres của Supabase: Session pooler (cổng 5432) hoặc Direct connection.
# KHÔNG dùng Transaction pooler (6543) — Flyway sẽ lỗi. Ví dụ: jdbc:postgresql://<host>:5432/postgres
DB_URL=
DB_USER=
DB_PASSWORD=
# Issuer của JWT Supabase Auth, ví dụ: https://<project-ref>.supabase.co/auth/v1
SUPABASE_JWT_ISSUER=
# JWKS của Supabase Auth (project phải bật JWT Signing Keys), ví dụ:
# https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=
# URL project Supabase, ví dụ: https://<project-ref>.supabase.co (backend gọi {SUPABASE_URL}/auth/v1)
SUPABASE_URL=
# Publishable key (sb_publishable_...) hoặc anon key cũ: header apikey khi backend gọi endpoint auth công khai
SUPABASE_ANON_KEY=
# Secret key (sb_secret_..., khuyên dùng) hoặc service_role cũ. Chỉ backend giữ; dùng cho Admin API (xoá user).
# sb_secret_ chỉ gửi ở header apikey (không phải JWT); service_role cũ gửi thêm Authorization: Bearer.
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=

# ---- Mobile (Expo) — chỉ anon key ----
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ---- Admin web (Vite) — chỉ anon key ----
VITE_API_BASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
