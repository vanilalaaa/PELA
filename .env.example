# Sao chép thành .env và điền giá trị. KHÔNG commit file .env.

# ---- Backend (Spring Boot) ----
# JDBC URL tới Postgres của Supabase, ví dụ: jdbc:postgresql://<host>:5432/postgres
DB_URL=
DB_USER=
DB_PASSWORD=
# Issuer của JWT Supabase Auth, ví dụ: https://<project-ref>.supabase.co/auth/v1
SUPABASE_JWT_ISSUER=
# JWKS của Supabase Auth, ví dụ: https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=
# Chỉ backend giữ service role key
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=

# ---- Mobile (Expo) — chỉ anon key ----
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ---- Admin web (Vite) — chỉ anon key ----
VITE_API_BASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
