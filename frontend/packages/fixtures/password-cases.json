{
  "version": 1,
  "rule": "Auth.Register.Validate (UC-01) + mức độ mạnh theo Figma PasswordStrength 575:11948",
  "notes": "valid khi đủ 4 luật: >= 8 ký tự, có chữ hoa, chữ thường, chữ số. level: 0 = rỗng; 1 = chưa hợp lệ; 2 = hợp lệ; 3 = hợp lệ và (có ký tự đặc biệt hoặc dài >= 12).",
  "cases": [
    { "id": "empty", "password": "", "valid": false, "level": 0, "rules": { "min_length": false, "uppercase": false, "lowercase": false, "digit": false } },
    { "id": "short-lower", "password": "abc", "valid": false, "level": 1, "rules": { "min_length": false, "uppercase": false, "lowercase": true, "digit": false } },
    { "id": "long-lower-digit", "password": "pela2026x", "valid": false, "level": 1, "rules": { "min_length": true, "uppercase": false, "lowercase": true, "digit": true } },
    { "id": "no-digit", "password": "PelaLearner", "valid": false, "level": 1, "rules": { "min_length": true, "uppercase": true, "lowercase": true, "digit": false } },
    { "id": "no-lower", "password": "PELA2026XY", "valid": false, "level": 1, "rules": { "min_length": true, "uppercase": true, "lowercase": false, "digit": true } },
    { "id": "short-but-mixed", "password": "Pe1a", "valid": false, "level": 1, "rules": { "min_length": false, "uppercase": true, "lowercase": true, "digit": true } },
    { "id": "exactly-8-valid", "password": "Pela2026", "valid": true, "level": 2, "rules": { "min_length": true, "uppercase": true, "lowercase": true, "digit": true } },
    { "id": "valid-11", "password": "Pela2026abc", "valid": true, "level": 2, "rules": { "min_length": true, "uppercase": true, "lowercase": true, "digit": true } },
    { "id": "valid-12-strong", "password": "Pela2026abcd", "valid": true, "level": 3, "rules": { "min_length": true, "uppercase": true, "lowercase": true, "digit": true } },
    { "id": "valid-special-strong", "password": "Pela@2026", "valid": true, "level": 3, "rules": { "min_length": true, "uppercase": true, "lowercase": true, "digit": true } },
    { "id": "vietnamese-letters", "password": "Ngọc2026a", "valid": true, "level": 2, "rules": { "min_length": true, "uppercase": true, "lowercase": true, "digit": true } },
    { "id": "special-but-invalid", "password": "pela@@@@", "valid": false, "level": 1, "rules": { "min_length": true, "uppercase": false, "lowercase": true, "digit": false } }
  ]
}
